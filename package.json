{
  "scripts": {
    "generate:proto": "./scripts/INSTALL_PROTOBUF.sh",
    "build": "npm run generate:proto && npm run lint && npm run test && tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.ts' 'tools/**/*.ts' 'tests/**/*.ts' 'example/**/*.ts'",
    "example:file": "ts-node -r tsconfig-paths/register example/file/fileExample.ts",
    "example:converter": "ts-node -r tsconfig-paths/register example/converter/converterExample.ts"
  },
  "devDependencies": {
    "@protobuf-ts/plugin": "^2.11.0",
    "@protobuf-ts/protoc": "^2.11.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "dependencies": {
    "@protobuf-ts/runtime": "^2.11.0"
  }
}
