{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": false,
    "paths": {
      "@/*": ["*"],
      "@generated/pcore": ["generated/pcore/pcore"],
      "@generated/pcoreVersion": ["generated/pcore/pcoreVersion"],
      "@tools/*": ["tools/*"],
      "@example/*": ["../example/*"]
    },
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": "src",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/generated/pcore/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
