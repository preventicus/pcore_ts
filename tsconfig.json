{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@generated/*": ["generated/pcore/*"],
      "@/*": ["src/*"],
      "@tools/*": ["tools/*"]
    },
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src", "generated"],
  "exclude": ["node_modules", "dist"]
}
